full range (old) : two-eps total = (-a**6*c/6 + a**5*(c - 1)/5 + a**4*(1 - 2*c)/4 - 2*a**3/3 - a**2*c/2 - a*(c + 1) + I*pi*c + (c + 1)*log(1 - a)/2 - (c + 1)*log(a - 1) + I*pi)/(c + 1) | single-eps = (-a**6*c/6 + a**5*(c - 1)/5 + a**4*(1 - 2*c)/4 - 2*a**3/3 - a**2*c/2 - a*(c + 1) + I*pi*c + (c + 1)*log(1 - a)/2 - (c + 1)*log(a - 1) + I*pi)/(c + 1) | series in a: a*(-c/(2*(c + 1)) - 1/(2*(c + 1))) + a**2*(-c/(4*(c + 1)) + 1/(4*(c + 1))) + O(a**3)
    IR part only: (-a**6*c/6 + a**5*(c - 1)/5 + a**4*(1 - 2*c)/4 - 2*a**3/3 - a**2*c/2 - a*(c + 1) + I*pi*c - (c + 1)*log(a - 1) + I*pi)/(c + 1)  series: a**2/(2*(c + 1)) + O(a**3)
range a<xi<1, R1 : two-eps total = log(1 - a)/2 | single-eps = log(1 - a)/2 | series in a: -a/2 - a**2/4 + O(a**3)
    IR part only: 0  series: 0
range a<xi<1, R2 : two-eps total = log(1 - a)/2 - log(a - 1) + I*pi | single-eps = log(1 - a)/2 - log(a - 1) + I*pi | series in a: a/2 + a**2/4 + O(a**3)
    IR part only: -log(a - 1) + I*pi  series: a + a**2/2 + O(a**3)
