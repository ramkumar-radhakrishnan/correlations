Q^11 - 2 Brace^11 = 0
Q^12 - 2 Brace^12 = 0
Q^21 - 2 Brace^21 = 0
Q^22 - 2 Brace^22 = 0
Brace^11 - Brace^22 = 0 ;  Brace^12 + Brace^21 = 0
alpha = Brace^11 = (a1*b1 - a1*b2 + a2*b1 + a2*b2)*(a1*b1 + a1*b2 - a2*b1 + a2*b2)/(2*(a1**2 + a2**2)*(b1**2 + b2**2)*(a1**2 - 2*a1*b1 + a2**2 - 2*a2*b2 + b1**2 + b2**2))
beta  = Brace^12 = (a1*b1 + a2*b2)*(a1*b2 - a2*b1)/((a1**2 + a2**2)*(b1**2 + b2**2)*(a1**2 - 2*a1*b1 + a2**2 - 2*a2*b2 + b1**2 + b2**2))
C * alpha at z->w : 1/2
C * beta  at z->w : 0
