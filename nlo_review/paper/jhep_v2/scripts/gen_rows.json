  "\\mathfrak{K}^{{\\rm quad},b}_{\\rm II.I}": "\\frac{1}{\\big[(x'-w')^{2}\\,(x-z)^{2}-(x-w)^{2}\\,(x'-z)^{2}\\big]}\\,\\log\\left[\\frac{(x-w)^{2}}{(x'-w')^{2}}\\right] \\times\\Bigg[(x-w)\\cdot\\mathcal{K}(z-w')\\,(x'-z)\\cdot\\mathcal{K}(z-w)-\\frac{1}{2}\\,(x-w)\\cdot\\mathcal{K}(x'-w')\\,\\mathcal{K}(z-w)\\cdot(x'-z) +\\frac{1}{2}\\,\\mathcal{K}(x-z)\\cdot(x'-z)\\,(x-w)\\cdot\\mathcal{K}(z-w') -\\frac{1}{4}\\,(x'-z)\\cdot\\mathcal{K}(x-z)\\,\\mathcal{K}(x'-w')\\cdot(x-w) +(x'-w')\\cdot\\mathcal{K}(z-w)\\,(x-z)\\cdot\\mathcal{K}(z-w')+\\frac{1}{2}\\,(x'-w')\\cdot\\mathcal{K}(z-w)\\,(x-z)\\cdot\\mathcal{K}(x'-z) -\\frac{1}{2}\\,(x-z)\\cdot\\mathcal{K}(z-w')\\,(x'-w')\\cdot\\mathcal{K}(x-w)-\\frac{1}{4}\\,(x'-w')\\cdot\\mathcal{K}(x-w)\\,(x-z)\\cdot\\mathcal{K}(x'-z)\\Bigg]",
