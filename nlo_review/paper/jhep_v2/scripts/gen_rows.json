  "\\mathfrak{K}^{{\\rm quad},d}_{\\rm II.I}": "\\frac{1}{\\big[(x'-w')^{2}\\,(x-z)^{2}-(x-w)^{2}\\,(x'-z)^{2}\\big]}\\,\\log\\left[\\frac{(x'-z)^{2}}{(x'-w')^{2}}\\right] \\times\\Bigg[\\frac{(x'-z)^{2}}{(x'-w')^{2}}\\bigg[(x'-w')\\cdot(x-w)\\,\\mathcal{K}(z-w)\\cdot\\mathcal{K}(z-w')+\\frac{1}{2}\\,(x'-w')\\cdot(x-w)\\,\\mathcal{K}(x'-z)\\cdot\\mathcal{K}(z-w) +\\frac{1}{2}\\,(x-w)\\cdot(x'-w')\\,\\mathcal{K}(x-z)\\cdot\\mathcal{K}(z-w')+\\frac{1}{4}\\,\\mathcal{K}(x-z)\\cdot\\mathcal{K}(x'-z)\\,(x'-w')\\cdot(x-w)\\bigg] +\\frac{(x'-w')^{2}}{(x'-z)^{2}}\\bigg[(x'-z)\\cdot(x-z)\\,\\mathcal{K}(z-w)\\cdot\\mathcal{K}(z-w')-\\frac{1}{2}\\,(x'-z)\\cdot(x-z)\\,\\mathcal{K}(x'-w')\\cdot\\mathcal{K}(z-w) -\\frac{1}{2}\\,\\mathcal{K}(x-w)\\cdot\\mathcal{K}(z-w')\\,(x-z)\\cdot(x'-z)+\\frac{1}{4}\\,(x-z)\\cdot(x'-z)\\,\\mathcal{K}(x'-w')\\cdot\\mathcal{K}(x-w)\\bigg] +\\frac{1}{(x'-w')^{2}-(x'-z)^{2}}\\bigg\\{(x'-z)^{2}\\bigg[\\frac{(x-w)\\cdot\\mathcal{K}(z-w)\\,\\big[(x'-z)^{2}-(x'-w')^{2}\\big]}{2\\,(z-w')^{2}} +\\frac{(x-w)\\cdot\\mathcal{K}(x-z)\\,\\big[(x'-z)^{2}-(x'-w')^{2}\\big]}{4\\,(z-w')^{2}} +\\frac{(x'-w')\\cdot\\mathcal{K}(z-w')\\,\\big[(x-z)^{2}-(x-w)^{2}\\big]}{2\\,(z-w)^{2}}+\\frac{(x'-w')\\cdot\\mathcal{K}(x'-z)\\,\\big[(x-z)^{2}-(x-w)^{2}\\big]}{4\\,(z-w)^{2}}\\bigg] -(x'-w')^{2}\\bigg[\\frac{(x-z)\\cdot\\mathcal{K}(z-w)\\,\\big[(x'-z)^{2}-(x'-w')^{2}\\big]}{2\\,(z-w')^{2}}-\\frac{(x-z)\\cdot\\mathcal{K}(x-w)\\,\\big[(x'-z)^{2}-(x'-w')^{2}\\big]}{4\\,(z-w')^{2}} +\\frac{(x'-z)\\cdot\\mathcal{K}(z-w')\\,\\big[(x-z)^{2}-(x-w)^{2}\\big]}{2\\,(z-w)^{2}}-\\frac{(x'-z)\\cdot\\mathcal{K}(x'-w')\\,\\big[(x-z)^{2}-(x-w)^{2}\\big]}{4\\,(z-w)^{2}}\\bigg]\\bigg\\} +\\frac{1}{2}\\,\\frac{(x'-w')^{2}\\,(x'-z)^{2}\\,\\big[(x-z)^{2}-(x-w)^{2}\\big]}{(z-w)^{2}\\,(z-w')^{2}\\,\\big[(x'-z)^{2}-(x'-w')^{2}\\big]}\\Bigg]"
