(* Content-type: application/vnd.wolfram.mathematica *)
(* Wolfram Notebook File *)
(* http://www.wolfram.com/nb *)

Notebook[{
Cell[CellGroupData[{
Cell["p^+ integration of  E^(-I a p/k) (A/(p+k) - B/p - 1/k)", "Title"],
Cell["Evaluate top to bottom (Evaluation > Evaluate Notebook).

  Integrate[Exp[-I a p/k] (A/(p + k) - B/p - 1/k), {p, Lam, V - k}]

in the window V >> k >> Lam > 0.  ASCII stand-ins:

  p   = p^+          k   = k^+        Lam = Lambda      V = \\[Vee]
  a   = k.(y'-z), the transverse phase, so the phase is E^(-I a p^+/k^+)
  A, B = the coefficients of the 1/(p^+ + k^+) and 1/p^+ poles

a is real and may have either sign.  Nothing here assumes |a| is small.", "Text"]
}, Open]],
Cell[CellGroupData[{
Cell["1.  Integrate", "Section"],
Cell["as = {a > 0, k > 0, Lam > 0, V > k + Lam};

res = Integrate[Exp[-I a p/k] (A/(p + k) - B/p - 1/k), {p, Lam, V - k},
   Assumptions -> as];
Simplify[res, Assumptions -> as]", "Input"],
Cell["The kernel returns

  A E^(I a) (-Ei[-I a (k + Lam)/k] + Ei[-I a V/k])
   + B (Ei[-I a Lam/k] - Ei[I a (k - V)/k])
   - I (-1 + E^(I a (k + Lam - V)/k))/(a E^(I a Lam/k))

with Ei = ExpIntegralEi.  Note Ei[I a (k - V)/k] = Ei[-I a (V - k)/k].", "Text"]
}, Open]],
Cell[CellGroupData[{
Cell["2.  Closed form", "Section"],
Cell["The same thing, one term per pole:

  Int dp E^(-I a p/k) A/(p+k) =  A E^(I a) [ Ei(-I a V/k) - Ei(-I a (k+Lam)/k) ]
  Int dp E^(-I a p/k) (-B/p)  = -B [ Ei(-I a (V-k)/k) - Ei(-I a Lam/k) ]
  Int dp E^(-I a p/k) (-1/k)  =  I [ E^(-I a Lam/k) - E^(-I a (V-k)/k) ] / a

Valid for either sign of a: the ExpIntegralEi arguments sit just off the imaginary axis, so no branch cut is crossed.  The -I0 that puts them there is the usual p^+ -> p^+ - I0 prescription.", "Text"],
Cell["PPlusExact[a_, k_, Lam_, V_, A_, B_] :=
  A Exp[I a] (ExpIntegralEi[-I a V/k] - ExpIntegralEi[-I a (k + Lam)/k])
  - B (ExpIntegralEi[-I a (V - k)/k] - ExpIntegralEi[-I a Lam/k])
  + I (Exp[-I a Lam/k] - Exp[-I a (V - k)/k])/a;", "Input"],
Cell["It agrees with what Integrate produced, identically:", "Text"],
Cell["Simplify[PPlusExact[a, k, Lam, V, A, B] - res, Assumptions -> as]", "Input"]
}, Open]],
Cell[CellGroupData[{
Cell["3.  The regime V >> k >> Lam", "Section"],
Cell["Two expansions do the work:

  Ei(-I x) = EulerGamma + Log[x] - I Pi/2 + O(x)     (small x)
  Ei(-I X) -> -I Pi Sign[X]                          (|X| -> Infinity)

so with |a| Lam/k << 1 << |a| V/k,", "Text"],
Cell["PPlusAsymptotic[a_, k_, Lam_, V_, A_, B_] :=
  With[{s = Sign[a]},
    -A Exp[I a] (ExpIntegralEi[-I a] + I Pi s)
    - B (Log[k/(Abs[a] Lam)] - EulerGamma - I Pi s/2)
    + I (1 - Exp[-I a (V - k)/k])/a
  ];

PPlusAsymptotic[a, k, Lam, V, A, B]", "Input"],
Cell["Three things fall out.

(1) V has cancelled out of the A and B terms.  The phase, not the upper cutoff, is what regulates them once |a| V/k >> 1.

(2) The only cutoff dependence left is the single logarithm Log[k/(|a| Lam)] on the B term -- the rapidity log rides on the 1/p^+ pole alone.

(3) The -1/k term keeps a boundary oscillation E^(-I a (V-k)/k) of unit modulus: no pointwise V -> Infinity limit, it only averages away against a smooth transverse profile.  And at a -> 0 that term is -(V - k - Lam)/k, linearly divergent -- it is finite only by virtue of the phase, so do not drop the phase there.  For reference, the whole integral at a = 0 is:", "Text"],
Cell["Integrate[A/(p + k) - B/p - 1/k, {p, Lam, V - k}, Assumptions -> as]", "Input"]
}, Open]],
Cell[CellGroupData[{
Cell["4.  Checks", "Section"],
Cell["Closed form against direct numerical integration, for both signs of a, and the asymptotic form against the exact one at Lam = 10^-8, V = 10^9.  Expect exact zeros in the first row and O(Lam, k/(a V)) ~ 10^-8 in the second.", "Text"],
Cell["tests = {{0.7, 1.3, 0.011, 310., 1.9, -0.6},
         {-0.7, 1.3, 0.011, 310., 1.9, -0.6},
         {2.2, 0.9, 0.004, 2000., 1., 1.},
         {0.35, 2.0, 0.02, 800., -1.4, 0.8}};

numeric[a_, k_, Lam_, V_, A_, B_] :=
  NIntegrate[Exp[-I a p/k] (A/(p + k) - B/p - 1/k), {p, Lam, V - k},
    Method -> \"LevinRule\", MaxRecursion -> 60, AccuracyGoal -> 12,
    PrecisionGoal -> 10];

<|
  \"exact - NIntegrate\" -> Chop[(PPlusExact @@ #) - (numeric @@ #) & /@ tests],
  \"asymptotic - exact\" ->
    ((PPlusAsymptotic[#[[1]], #[[2]], 10^-8, 10^9, #[[5]], #[[6]]] -
       PPlusExact[#[[1]], #[[2]], 10^-8, 10^9, #[[5]], #[[6]]]) & /@ tests)
|>", "Input"],
Cell["PPlusExact @@ tests[[1]]", "Input"],
Cell["Exact vs asymptotic as a function of the phase a, at k = 1.3, Lam = 0.011, V = 310, A = 1.9, B = -0.6.  The two curves separate at small a, where |a| V/k >> 1 fails and the V logarithm has not yet been traded for the a logarithm; the wiggle in the exact curve is the boundary oscillation of (3).", "Text"],
Cell["With[{k0 = 1.3, Lam0 = 0.011, V0 = 310., A0 = 1.9, B0 = -0.6},
  Plot[
    Evaluate[{Re[PPlusExact[a, k0, Lam0, V0, A0, B0]],
              Re[PPlusAsymptotic[a, k0, Lam0, V0, A0, B0]],
              Im[PPlusExact[a, k0, Lam0, V0, A0, B0]],
              Im[PPlusAsymptotic[a, k0, Lam0, V0, A0, B0]]}],
    {a, 0.02, 3},
    PlotStyle -> {Automatic, Directive[Dashed, Thick], Automatic,
      Directive[Dashed, Thick]},
    PlotLegends -> {\"Re exact\", \"Re asymptotic\", \"Im exact\",
      \"Im asymptotic\"},
    AxesLabel -> {\"a\", None}, PlotRange -> All, ImageSize -> 560]]", "Input"]
}, Open]]
},
WindowSize->{1100, 850},
WindowMargins->Automatic,
StyleDefinitions->"Default.nb"
]
